<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CityHelper.ViewModels"
        x:Class="CityHelper.Views.OptionsWindow"
        x:DataType="vm:OptionsViewModel"
        Title="Options"
        Width="860" Height="720" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Grid RowDefinitions="*,Auto" Margin="16">

    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Sections}" Margin="0,0,16,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OptionsSectionViewModel">
            <StackPanel Spacing="10" Margin="0,0,0,24">
              <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
              <Border BorderBrush="#3F3F46" BorderThickness="0,1,0,0" />
              <ContentControl Content="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="90" HorizontalContentAlignment="Center" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
