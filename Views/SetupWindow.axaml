<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CityHelper.ViewModels"
        x:Class="CityHelper.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Title="Welcome to CityHelper" Width="680" SizeToContent="Height" MaxHeight="760"
        CanResize="False" WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="Welcome to CityHelper" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="A little setup first. You can change all of this later in Options." Opacity="0.7" TextWrapping="Wrap"/>

      <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>
      <TextBlock Text="1. City of Heroes installations" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding IntroText}" Opacity="0.7" TextWrapping="Wrap"/>

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SetupInstallation">
            <Grid ColumnDefinitions="Auto,170,*" ColumnSpacing="8" Margin="0,3">
              <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0"/>
              <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Display name"/>
              <TextBox Grid.Column="2" Text="{Binding Path}" PlaceholderText="Folder"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Add Folder..." Click="OnAddFolder"/>
        <Button Content="Search Again" Click="OnSearchAgain"/>
      </StackPanel>

      <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0"/>
      <TextBlock Text="2. Config Sync (optional)" FontWeight="SemiBold"/>
      <TextBlock Text="Config Sync copies your chat, client and key bind settings between installations and keeps a backup. You can skip this and set it up later."
                 Opacity="0.7" TextWrapping="Wrap"/>
      <CheckBox Content="Set up Config Sync now" IsChecked="{Binding SetUpConfigSync}"/>
      <StackPanel Spacing="4" IsEnabled="{Binding SetUpConfigSync}">
        <TextBlock Text="Sync folder (where Config Sync keeps its copy, for example a folder in OneDrive or Dropbox):"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Text="{Binding SyncFolder}"/>
          <Button Grid.Column="1" Content="Browse..." Click="OnBrowseSyncFolder"/>
        </Grid>
        <TextBlock Text="The first installation is the default; the others use its settings. Adjust items in Options later."
                   Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>

      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ChError}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button Content="Skip Setup" Click="OnSkip" MinWidth="100" HorizontalContentAlignment="Center"/>
        <Button Content="Finish" Click="OnFinish" IsDefault="True" MinWidth="100" HorizontalContentAlignment="Center"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
