<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CityHelper.ViewModels"
        x:Class="CityHelper.Views.MacroImageLookupWindow"
        x:DataType="vm:MacroImageLookupViewModel"
        Title="Macro Images" Width="640" Height="720" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Search}" Width="260" PlaceholderText="search texture names" />
        <ComboBox Width="190" ItemsSource="{Binding SectionNames}" SelectedItem="{Binding SelectedSection}" />
        <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
      <TextBlock Text="Insert puts the texture name into the Icon field." Opacity="0.65" FontSize="11" />
    </StackPanel>

    <!-- The list is virtualized: only the rows in view are created, so the thousands of images load as you scroll -->
    <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="1">
      <ListBox ItemsSource="{Binding Rows}" SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MacroImageRow">
            <Panel>
              <TextBlock Text="{Binding Heading}" IsVisible="{Binding IsHeading}" FontWeight="SemiBold" FontSize="14"
                         Margin="0,10,0,4" />
              <Grid IsVisible="{Binding IsImage}" ColumnDefinitions="48,*,Auto" Height="40">
                <Image Source="{Binding Image}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0" />
                <Button Grid.Column="2" Content="Insert" Click="OnInsert" VerticalAlignment="Center" Padding="14,3" />
              </Grid>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
