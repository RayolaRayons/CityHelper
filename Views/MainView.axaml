<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CityHelper.ViewModels"
             xmlns:rb="clr-namespace:CityHelper.Ribbon"
             xmlns:tools="clr-namespace:CityHelper.Tools"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="CityHelper.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <!-- Shortcuts for the selected tool's Save and Refresh (disabled when the tool has none) -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C97EA"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Menu MenuItem MenuItem">
            <Setter Property="Command" Value="{ReflectionBinding Command}"/>
            <Setter Property="ToolTip.Tip" Value="{ReflectionBinding Tooltip}"/>
            <Setter Property="IsHitTestVisible" Value="{ReflectionBinding !IsSeparator}"/>
            <Setter Property="Padding" Value="8,4"/>
          </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
          <TreeDataTemplate DataType="rb:RibbonTab" ItemsSource="{Binding Entries}">
            <TextBlock Text="{Binding Header}"/>
          </TreeDataTemplate>
          <TreeDataTemplate DataType="rb:RibbonGroup" ItemsSource="{Binding Commands}">
            <TextBlock Text="{Binding Header}"/>
          </TreeDataTemplate>
          <DataTemplate DataType="rb:RibbonCommand">
            <Panel>
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsSeparator}">
                <PathIcon Data="{Binding Icon}" Width="16" Height="16"/>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
              </StackPanel>
              <Border Height="1" Background="{DynamicResource ChBorder}" Margin="0,3" MinWidth="120"
                      IsVisible="{Binding IsSeparator}"/>
            </Panel>
          </DataTemplate>
  </UserControl.DataTemplates>
  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="260,Auto,*">

      <!-- Left column -->
      <Grid Grid.Column="0" MinWidth="160">
        <ListBox ItemsSource="{Binding Tools}"
                 SelectedItem="{Binding SelectedTool}">
          <!-- The divider between the two groups is a disabled item: a line, not selectable -->
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="tools:ITool">
              <Setter Property="IsEnabled" Value="{Binding !IsSeparator}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="tools:ITool">
              <Panel>
                <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsSeparator}"/>
                <Border Height="1" Margin="0,6" Background="{DynamicResource ChBorder}" IsVisible="{Binding IsSeparator}"/>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource ChBorder}" ResizeDirection="Columns"/>

      <!-- Content pane: view chosen by ViewLocator from the tool's view model -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChPanel}" BorderBrush="{DynamicResource ChBorder}" BorderThickness="0,0,0,1"
                IsVisible="{Binding HasToolMenus}">
          <Menu ItemsSource="{Binding ToolMenus}"/>
        </Border>
        <ContentControl Content="{Binding CurrentContent}"/>
      </DockPanel>
    </Grid>

    <!-- Status bar: full width. Left = selection segments, right = reserved for tool status messages -->
    <Border Grid.Row="1" Background="#007ACC" Height="26">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="Installation:" Foreground="White" Opacity="0.75" FontSize="12"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
          <Button x:Name="InstallationSegment" Classes="segment"
                  Content="{Binding State.SelectedInstallation.Name}"
                  ToolTip.Tip="{Binding State.SelectedInstallation.Path}">
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <ListBox MinWidth="200" ItemsSource="{Binding State.Installations}"
                         SelectedItem="{Binding State.SelectedInstallation}"
                         Tapped="OnInstallationPicked"/>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Width="1" Margin="0,5" Background="#80FFFFFF"/>
          <TextBlock Text="Account:" Foreground="White" Opacity="0.75" FontSize="12"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
          <Button x:Name="AccountSegment" Classes="segment"
                  Content="{Binding State.SelectedAccount.Name, TargetNullValue='(no accounts)'}">
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedLeft">
                <ListBox MinWidth="160" ItemsSource="{Binding State.Accounts}"
                         SelectedItem="{Binding State.SelectedAccount}"
                         Tapped="OnAccountPicked"/>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ToolStatus}" Foreground="White" FontSize="12"
                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,10,0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</UserControl>


