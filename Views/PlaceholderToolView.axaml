<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.ViewModels"
             x:Class="CityHelper.Views.PlaceholderToolView"
             x:DataType="vm:PlaceholderToolViewModel">
  <StackPanel Margin="24" Spacing="8">
    <TextBlock Text="{Binding ToolName}" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding State.SelectedInstallation.Name, StringFormat='Installation: {0}'}"/>
    <TextBlock Text="{Binding State.SelectedInstallation.Path, StringFormat='Path: {0}'}" Opacity="0.7"/>
    <TextBlock Text="{Binding State.SelectedAccount.Name, StringFormat='Account: {0}'}"/>
  </StackPanel>
</UserControl>
