<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.PiggViewer.ViewModels"
             x:Class="CityHelper.Tools.PiggViewer.Views.BinaryPreviewView"
             x:DataType="vm:BinaryPreviewViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Note}" IsVisible="{Binding Note.Length}" Foreground="{DynamicResource ChWarn}" Margin="8,4" />
    <TextBox Text="{Binding Hex, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             BorderThickness="0" FontFamily="Cascadia Mono, Consolas, Courier New, monospace" FontSize="12.5"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <TextBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Export..." Command="{Binding ExportCommand}" />
        </ContextMenu>
      </TextBox.ContextMenu>
    </TextBox>
  </DockPanel>
</UserControl>
