<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.PiggViewer.ViewModels"
             x:Class="CityHelper.Tools.PiggViewer.Views.PiggViewerView"
             x:DataType="vm:PiggViewerViewModel">

  <UserControl.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:DirectoryNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
    <Style Selector="Button.mini">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="12">

    <!-- Toolbar: pick a folder or an archive of the installation, load it, export what is loaded -->
    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Folder:" VerticalAlignment="Center" />
        <ComboBox MinWidth="150" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                  PlaceholderText="No folders" ToolTip.Tip="Folders of the installation's assets folder that hold archives" />
        <Button Content="Load Folder" Command="{Binding LoadFolderCommand}"
                ToolTip.Tip="Open every archive in the chosen folder together" />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <TextBlock Text="File:" VerticalAlignment="Center" />
        <ComboBox MinWidth="220" ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}"
                  PlaceholderText="No archives" ToolTip.Tip="The archives (.pigg) in the chosen folder" />
        <Button Content="Load File" Command="{Binding LoadArchiveCommand}"
                ToolTip.Tip="Open the chosen archive" />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <Button Content="{Binding ExportText}" Command="{Binding ExportCommand}"
                ToolTip.Tip="Export the selection: the files selected in the list, or, if none are, the selected folder with everything under it" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="mini" Content="Browse Folder..." Command="{Binding OpenFolderCommand}" />
        <Button Classes="mini" Content="Browse Archive..." Command="{Binding OpenArchiveCommand}" />
        <Button Classes="mini" Content="New From Folder..." Command="{Binding NewFromFolderCommand}"
                ToolTip.Tip="Pack a folder into a new .pigg archive" />
        <Button Classes="mini" Content="Pack Texture..." Command="{Binding PackTextureCommand}" />
        <Button Classes="mini" Content="Close" Command="{Binding CloseCommand}" />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <ComboBox Width="130" FontSize="12" ItemsSource="{Binding SearchFilters}" SelectedItem="{Binding SelectedSearchFilter}"
                  ToolTip.Tip="What to search: All, Folder names only, or one type of file" />
        <TextBox Text="{Binding SearchText}" Width="280" FontSize="12"
                 PlaceholderText="search texture or folder name"
                 ToolTip.Tip="Finds the word in folder names and texture (file) names of what is loaded. Enter = next, Shift+Enter = previous.">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding NextResultCommand}" />
            <KeyBinding Gesture="Shift+Enter" Command="{Binding PreviousResultCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Classes="mini" Content="◀" Command="{Binding PreviousResultCommand}" ToolTip.Tip="Previous match (Shift+Enter)" />
        <Button Classes="mini" Content="▶" Command="{Binding NextResultCommand}" ToolTip.Tip="Next match (Enter)" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="260,Auto,*">

      <!-- Folder tree -->
      <Border Grid.Column="0" BorderBrush="{DynamicResource ChBorder}" BorderThickness="1">
        <TreeView x:Name="DirTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedDirectory}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:DirectoryNodeViewModel" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}" />
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Export Folder..." Command="{Binding ExportDirectoryCommand}" />
            </ContextMenu>
          </TreeView.ContextMenu>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="*,Auto,1.3*">

        <!-- Files of the selected folder -->
        <DockPanel Grid.Row="0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,140,120,90,90" Margin="8,0,16,2">
            <TextBlock Grid.Column="0" Classes="header" Text="Name" />
            <TextBlock Grid.Column="1" Classes="header" Text="Date modified" />
            <TextBlock Grid.Column="2" Classes="header" Text="Type" />
            <TextBlock Grid.Column="3" Classes="header" Text="Size" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="header" Text="Packed" HorizontalAlignment="Right" />
          </Grid>
          <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="1">
            <ListBox x:Name="FileList" ItemsSource="{Binding Files}" SelectionMode="Multiple">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileRowViewModel">
                  <Grid ColumnDefinitions="*,140,120,90,90">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" Opacity="0.8" />
                    <TextBlock Grid.Column="2" Text="{Binding TypeText}" Opacity="0.8" />
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" Opacity="0.8" />
                    <TextBlock Grid.Column="4" Text="{Binding PackedText}" HorizontalAlignment="Right" Opacity="0.8" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Export Files..." Command="{Binding ExportFilesCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
          </Border>
        </DockPanel>

        <GridSplitter Grid.Row="1" Height="6" Background="Transparent" ResizeDirection="Rows" />

        <!-- Preview of the selected file: texture, text or hex -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource ChBorder}" BorderThickness="1">
          <ContentControl Content="{Binding Preview}" />
        </Border>
      </Grid>
    </Grid>

  </Grid>
</UserControl>
