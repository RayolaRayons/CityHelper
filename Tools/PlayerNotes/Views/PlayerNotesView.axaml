<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.PlayerNotes.ViewModels"
             x:Class="CityHelper.Tools.PlayerNotes.Views.PlayerNotesView"
             x:DataType="vm:PlayerNotesViewModel">

  <UserControl.Styles>
    <!-- Sortable column headers look like the plain header text -->
    <Style Selector="Button.header">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Padding" Value="4,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Star rating: unlit stars are dim, lit ones gold -->
    <Style Selector="Button.star">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource ChStarOff}" />
    </Style>
    <Style Selector="Button.star.on">
      <Setter Property="Foreground" Value="#FFC800" />
    </Style>
    <Style Selector="Button.star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFE066" />
    </Style>
    <Style Selector="Button.star:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.star:not(:pointerover).on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#FFC800" />
    </Style>
    <Style Selector="Button.star:not(:pointerover):not(.on) /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource ChStarOff}" />
    </Style>

    <!-- A cell shows about three lines and scrolls inside itself when there is more -->
    <Style Selector="TextBox.cell">
      <Setter Property="Height" Value="76" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Filter:" VerticalAlignment="Center" />
        <TextBox Width="300" Text="{Binding Filter}" PlaceholderText="global name, character or notes"
                 ToolTip.Tip="Shows players whose global name, any of their characters, or their notes contain this text" />
        <Button Content="Add Player" Command="{Binding AddRowCommand}" />
        <Button Content="Reload" Command="{Binding ReloadCommand}"
                ToolTip.Tip="Discard unsaved changes and read the file again" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Grid ColumnDefinitions="200,130,*,2*,40" Background="{DynamicResource ChHeader}" Margin="0,4,18,0">
        <Button Grid.Column="0" Content="{Binding NameHeader}" Command="{Binding SortByNameCommand}" Classes="header"
                ToolTip.Tip="Click to sort by name; click again to reverse" />
        <Button Grid.Column="1" Content="{Binding StarsHeader}" Command="{Binding SortByStarsCommand}" Classes="header"
                ToolTip.Tip="Click to sort by stars; click again to reverse" />
        <TextBlock Grid.Column="2" Text="Characters" Margin="8,4" FontWeight="SemiBold" />
        <TextBlock Grid.Column="3" Text="Notes" Margin="8,4" FontWeight="SemiBold" />
      </Grid>
    </StackPanel>

    <!-- ListBox virtualizes, which matters with well over a thousand players -->
    <ListBox ItemsSource="{Binding Rows}" SelectionMode="Single" Padding="0">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PlayerNoteRowViewModel">
          <Grid ColumnDefinitions="200,130,*,2*,40" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding Name}" VerticalContentAlignment="Top" Height="76" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" ToolTip.Tip="Click a star to set the rating; click it again to clear">
              <Button Classes="star" Classes.on="{Binding Star1On}" Command="{Binding SetStarsCommand}" CommandParameter="1" Content="★" />
              <Button Classes="star" Classes.on="{Binding Star2On}" Command="{Binding SetStarsCommand}" CommandParameter="2" Content="★" />
              <Button Classes="star" Classes.on="{Binding Star3On}" Command="{Binding SetStarsCommand}" CommandParameter="3" Content="★" />
              <Button Classes="star" Classes.on="{Binding Star4On}" Command="{Binding SetStarsCommand}" CommandParameter="4" Content="★" />
              <Button Classes="star" Classes.on="{Binding Star5On}" Command="{Binding SetStarsCommand}" CommandParameter="5" Content="★" />
            </StackPanel>
            <TextBox Grid.Column="2" Classes="cell" Text="{Binding Characters}" />
            <TextBox Grid.Column="3" Classes="cell" Text="{Binding Notes}" />
            <Button Grid.Column="4" Content="✕" Command="{Binding RemoveCommand}" VerticalAlignment="Top"
                    HorizontalContentAlignment="Center" ToolTip.Tip="Remove this player" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
