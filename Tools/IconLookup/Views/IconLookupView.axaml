<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.IconLookup.ViewModels"
             xmlns:rows="using:CityHelper.ViewModels"
             x:Class="CityHelper.Tools.IconLookup.Views.IconLookupView"
             x:DataType="vm:IconLookupViewModel">

  <Grid ColumnDefinitions="380,Auto,*" Margin="16">

    <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
        <TextBox Text="{Binding Search}" PlaceholderText="search texture name" />
        <ComboBox ItemsSource="{Binding SectionNames}" SelectedItem="{Binding SelectedSection}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="1">
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="rows:MacroImageRow">
              <Panel>
                <TextBlock IsVisible="{Binding IsHeading}" Text="{Binding Heading}" FontWeight="Bold" Opacity="0.8" Margin="0,6,0,2" />
                <StackPanel IsVisible="{Binding IsImage}" Orientation="Horizontal" Spacing="8">
                  <Image Source="{Binding Image}" Width="32" Height="32" Stretch="Uniform" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

    <ScrollViewer Grid.Column="2" IsVisible="{Binding HasSelection}" Margin="6,0,0,0">
      <StackPanel Spacing="12" Margin="0,0,12,0">
        <TextBlock Text="{Binding SelectedName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Copy Name" Click="OnCopyName" ToolTip.Tip="Copy the texture name" />
        </StackPanel>
        <Image Source="{Binding Selected.Image}" Width="128" Height="128" Stretch="Uniform" HorizontalAlignment="Left" />
        <StackPanel Spacing="2">
          <TextBlock Text="Section" FontWeight="SemiBold" Opacity="0.8" />
          <TextBlock Text="{Binding SelectedGroup}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="Texture name" FontWeight="SemiBold" Opacity="0.8" />
          <TextBox Text="{Binding SelectedName}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, monospace" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
