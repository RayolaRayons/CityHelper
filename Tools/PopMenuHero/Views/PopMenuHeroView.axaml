<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CityHelper.Tools.PopMenuHero.ViewModels"
        xmlns:app="using:CityHelper.Tools.PopMenuHero"
        xmlns:rb="using:CityHelper.Ribbon"
        xmlns:ctl="using:CityHelper.Tools.PopMenuHero.Controls"
        x:Class="CityHelper.Tools.PopMenuHero.Views.PopMenuHeroView"
        x:DataType="vm:PopMenuHeroViewModel"
        >

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportMenuCommand}" />
    <!-- Undo / Copy / Paste / Delete are bound on the tree, so text boxes keep their own -->
  </UserControl.KeyBindings>

  <UserControl.Resources>
    <ControlTheme x:Key="ExpanderToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Path Name="Chevron" Data="M 0 0 L 5 4.5 L 0 9 Z" Fill="#666"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Path#Chevron">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
      </Style>
    </ControlTheme>

    <!-- Own TreeViewItem template: per-kind row colour, our own selection colour,
         and known part names for drag-and-drop hit testing. -->
    <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Border Name="PART_Header" Background="Transparent" MinHeight="26"
                    Padding="{TemplateBinding Level, Converter={x:Static app:IndentConverter.Instance}}">
              <DockPanel>
                <Panel DockPanel.Dock="Left" Width="20">
                  <ToggleButton Name="PART_Expander" Theme="{StaticResource ExpanderToggle}" Focusable="False"
                                IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                </Panel>
                <ContentPresenter Name="PART_HeaderPresenter"
                                  Background="{TemplateBinding Background}"
                                  Padding="{TemplateBinding Padding}"
                                  CornerRadius="2"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalContentAlignment="Center" />
              </DockPanel>
            </Border>
            <ItemsPresenter Name="PART_ItemsPresenter"
                            IsVisible="{TemplateBinding IsExpanded}"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:empty /template/ ToggleButton#PART_Expander">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ Border#PART_Header:pointerover > DockPanel > ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="{DynamicResource ChHover}" />
      </Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Background" Value="#0078d4" />
        <Setter Property="Foreground" Value="White" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TreeView#Tree TreeViewItem" x:DataType="vm:NodeViewModel">
      <Setter Property="Background" Value="{Binding Kind, Converter={x:Static app:NodeKindBrushConverter.Row}}" />
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>

    <Style Selector="Border.toolbar Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style Selector="Border.toolbar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChToolHover}" />
    </Style>

    <Style Selector="WrapPanel.add Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,4,4,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChBorder2}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.delete">
      <Setter Property="Foreground" Value="{DynamicResource ChDelFg}" />
      <Setter Property="Background" Value="{DynamicResource ChDelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChDelBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.delete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChDelHover}" />
      <Setter Property="Foreground" Value="{DynamicResource ChDelFg}" />
    </Style>

    <!-- Property form rows -->
    <Style Selector="Grid.field">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.field > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{DynamicResource ChMuted}" />
    </Style>
    <Style Selector="Grid.field > TextBlock.top">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,6,8,0" />
    </Style>
    <!-- Shared multi-line field: fixed ~4-line height, wraps, scrolls vertically, never stretches -->
    <Style Selector="TextBox.multiline">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Height" Value="88" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="StackPanel.undocumented">
      <Setter Property="Margin" Value="0,8,0,2" />
      <Setter Property="Spacing" Value="3" />
    </Style>
    <Style Selector="StackPanel.undocumented > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ChMuted2}" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar" Background="{DynamicResource ChPanel}" BorderBrush="{DynamicResource ChBorder}" BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding ToolbarCommands}" Margin="0,0,16,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="rb:RibbonCommand">
              <Panel>
                <Button Command="{Binding Command}" ToolTip.Tip="{Binding Tooltip}"
                        IsVisible="{Binding !IsSeparator}">
                  <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
                </Button>
                <Border Width="1" Margin="6,2" Background="{DynamicResource ChBorder}" IsVisible="{Binding IsSeparator}" />
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding WindowTitle}" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="*,4,400" Margin="4">
      <!-- Left: tree + buttons -->
      <DockPanel Grid.Column="0" MinWidth="300">
        <Button DockPanel.Dock="Bottom" Classes="delete" Content="🗑 Delete Selected"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                Command="{Binding DeleteSelectedCommand}" />
        <WrapPanel DockPanel.Dock="Bottom" Classes="add">
          <Button Content="+ Menu" Command="{Binding AddMenuCommand}" />
          <Button Content="+ Option" Command="{Binding AddOptionCommand}" />
          <Button Content="+ LockedOpt" Command="{Binding AddLockedOptionCommand}" />
          <Button Content="+ Title" Command="{Binding AddTitleCommand}" />
          <Button Content="+ Divider" Command="{Binding AddDividerCommand}" />
          <Button Content="+ Comment" Command="{Binding AddCommentCommand}" />
          <Button Content="⚠ + Dialog" Command="{Binding AddDialogCommand}" />
          <Button Content="⚠ + Text" Command="{Binding AddTextCommand}" />
        </WrapPanel>

        <Panel>
          <TreeView x:Name="Tree"
                    ItemsSource="{Binding RootItems}"
                    SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                    Background="{DynamicResource ChTree}" BorderBrush="{DynamicResource ChBorder}" BorderThickness="1" CornerRadius="4"
                    FontSize="13" Padding="2">
            <TreeView.KeyBindings>
              <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
              <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
              <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteCommand}" />
              <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
            </TreeView.KeyBindings>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                <ctl:HotkeyLabel Markup="{Binding Label}" VerticalAlignment="Center" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add">
                  <MenuItem Header="Menu" Command="{Binding AddMenuCommand}" />
                  <MenuItem Header="Option" Command="{Binding AddOptionCommand}" />
                  <MenuItem Header="Locked Option" Command="{Binding AddLockedOptionCommand}" />
                  <MenuItem Header="Title" Command="{Binding AddTitleCommand}" />
                  <MenuItem Header="Divider" Command="{Binding AddDividerCommand}" />
                  <MenuItem Header="Comment" Command="{Binding AddCommentCommand}" />
                  <Separator />
                  <MenuItem Header="⚠ Dialog" Command="{Binding AddDialogCommand}" />
                  <MenuItem Header="⚠ Text" Command="{Binding AddTextCommand}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Copy" Command="{Binding CopyCommand}" />
                <MenuItem Header="Paste" Command="{Binding PasteCommand}" />
                <Separator />
                <MenuItem Header="Delete Selected" Command="{Binding DeleteSelectedCommand}" />
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
          <!-- Drag-and-drop indicator, drawn over the tree -->
          <Canvas x:Name="DropOverlay" IsHitTestVisible="False">
            <Border x:Name="DropIndicator" IsVisible="False" BorderBrush="#0078d4" CornerRadius="2" />
          </Canvas>
        </Panel>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- Right: property panel + optional MNU preview -->
      <Grid Grid.Column="2" x:Name="RightPanel" MinWidth="280">
        <DockPanel Grid.Row="0" Background="{DynamicResource ChPanel}">
          <TextBlock DockPanel.Dock="Top" Text="No item selected" FontSize="15" FontWeight="Bold"
                     Margin="12,12,12,4"
                     IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNull}}" />
          <Border DockPanel.Dock="Top" Margin="8,8,8,0" Padding="10,6" CornerRadius="4"
                  Background="{Binding SelectedNode.Kind, Converter={x:Static app:NodeKindBrushConverter.Header}, FallbackValue={x:Null}}"
                  IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding SelectedNode.Header, FallbackValue=''}" Foreground="White" FontSize="16" FontWeight="Bold" />
          </Border>
          <Separator DockPanel.Dock="Top" Margin="8,6" />

          <ScrollViewer Padding="8,0,12,8">
            <ContentControl Content="{Binding SelectedNode}" VerticalAlignment="Top" VerticalContentAlignment="Top">
              <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:MenuNodeViewModel">
                  <StackPanel>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Text="Name:" />
                      <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Menu name" />
                    </Grid>
                    <Expander Header="⚠  Undocumented features" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                      <StackPanel>
                      <Grid Classes="field" ColumnDefinitions="120,*">
                        <TextBlock Text="Requires:" />
                        <TextBox Grid.Column="1" Text="{Binding Requires}" PlaceholderText="Requirement expression" />
                      </Grid>
                      <Grid Classes="field" ColumnDefinitions="120,*">
                        <TextBlock Text="Visible Requires:" />
                        <TextBox Grid.Column="1" Text="{Binding VisibleRequires}" PlaceholderText="Visibility requirement expression" />
                      </Grid>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:OptionNodeViewModel">
                  <StackPanel>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Text="Display Name:" />
                      <TextBox Grid.Column="1" Text="{Binding DisplayName}" PlaceholderText="Display name" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Classes="top" Text="Command:" />
                      <TextBox Grid.Column="1" Classes="multiline" Text="{Binding Command}"
                               PlaceholderText="Command string (use $$ to chain)" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:LockedOptionNodeViewModel">
                  <StackPanel>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Text="Display Name:" />
                      <TextBox Grid.Column="1" Text="{Binding DisplayName}" PlaceholderText="Display name" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Classes="top" Text="Command:" />
                      <TextBox Grid.Column="1" Classes="multiline" Text="{Binding Command}"
                               PlaceholderText="Command string (use $$ to chain)" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="120,*,Auto,Auto">
                      <TextBlock Text="Icon:" />
                      <TextBox Grid.Column="1" Text="{Binding Icon}" />
                      <Button Grid.Column="2" Margin="4,0,0,0" Content="Lookup..." Click="OnLookupIcon"
                              ToolTip.Tip="Pick a macro image: sections, pictures and texture names" />
                      <ctl:HelpButton Grid.Column="3" Margin="4,0,0,0" ToolTip.Tip="Open icon reference"
                                      Url="https://homecoming.wiki/wiki/Macro_image_(Slash_Command)" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="120,*,Auto">
                      <TextBlock Text="Badge(s):" />
                      <TextBox Grid.Column="1" Text="{Binding Badge}" PlaceholderText="Space-separated badge list" />
                      <ctl:HelpButton Grid.Column="2" Margin="4,0,0,0" ToolTip.Tip="Open badge reference"
                                      Url="https://homecoming.wiki/wiki/Badges" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="120,*,Auto">
                      <TextBlock Text="Power Ready:" />
                      <TextBox Grid.Column="1" Text="{Binding PowerReady}" PlaceholderText="Power name" />
                      <ctl:HelpButton Grid.Column="2" Margin="4,0,0,0" ToolTip.Tip="Open power reference"
                                      Url="https://cod.uberguy.net" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="120,*,Auto">
                      <TextBlock Text="Power Owned:" />
                      <TextBox Grid.Column="1" Text="{Binding PowerOwned}" PlaceholderText="Power name" />
                      <ctl:HelpButton Grid.Column="2" Margin="4,0,0,0" ToolTip.Tip="Open power reference"
                                      Url="https://cod.uberguy.net" />
                    </Grid>
                    <Expander Header="⚠  Undocumented features" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                      <StackPanel>
                      <Grid Classes="field" ColumnDefinitions="120,*">
                        <TextBlock Text="Requires:" />
                        <TextBox Grid.Column="1" Text="{Binding Requires}" PlaceholderText="Requirement expression" />
                      </Grid>
                      <Grid Classes="field" ColumnDefinitions="120,*">
                        <TextBlock Text="Visible Requires:" />
                        <TextBox Grid.Column="1" Text="{Binding VisibleRequires}" PlaceholderText="Visibility requirement expression" />
                      </Grid>
                      </StackPanel>
                    </Expander>
                    <Expander Header="Deprecated fields" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                      <StackPanel>
                      <Grid Classes="field" ColumnDefinitions="120,*">
                        <TextBlock Text="Authbit:" />
                        <TextBox Grid.Column="1" Text="{Binding Authbit}" PlaceholderText="(deprecated)" />
                      </Grid>
                      <Grid Classes="field" ColumnDefinitions="120,*">
                        <TextBlock Text="Reward Token:" />
                        <TextBox Grid.Column="1" Text="{Binding RewardToken}" PlaceholderText="(deprecated)" />
                      </Grid>
                      <Grid Classes="field" ColumnDefinitions="120,*">
                        <TextBlock Text="Store Product:" />
                        <TextBox Grid.Column="1" Text="{Binding StoreProduct}" PlaceholderText="(deprecated)" />
                      </Grid>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:DialogNodeViewModel">
                  <StackPanel>
                    <StackPanel Classes="undocumented">
                      <Separator />
                      <TextBlock Text="⚠  Undocumented feature" />
                    </StackPanel>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Text="Display Name:" />
                      <TextBox Grid.Column="1" Text="{Binding DisplayName}" PlaceholderText="Display name" />
                    </Grid>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Classes="top" Text="Command:" />
                      <TextBox Grid.Column="1" Classes="multiline" Text="{Binding Command}"
                               PlaceholderText="Command string (use $$ to chain)" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:TitleNodeViewModel">
                  <Grid Classes="field" ColumnDefinitions="120,*">
                    <TextBlock Classes="top" Text="Text:" />
                    <TextBox Grid.Column="1" Classes="multiline" Text="{Binding Text}" PlaceholderText="Display Title" />
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:TextNodeViewModel">
                  <StackPanel>
                    <StackPanel Classes="undocumented">
                      <Separator />
                      <TextBlock Text="⚠  Undocumented feature" />
                    </StackPanel>
                    <Grid Classes="field" ColumnDefinitions="120,*">
                      <TextBlock Classes="top" Text="Text:" />
                      <TextBox Grid.Column="1" Classes="multiline" Text="{Binding Text}" PlaceholderText="Display Title" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:CommentNodeViewModel">
                  <Grid Classes="field" ColumnDefinitions="120,*">
                    <TextBlock Classes="top" Text="Comment:" />
                    <TextBox Grid.Column="1" Classes="multiline" Text="{Binding Text}"
                             PlaceholderText="Comment text" />
                  </Grid>
                </DataTemplate>

                <DataTemplate DataType="vm:DividerNodeViewModel">
                  <Panel />
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
