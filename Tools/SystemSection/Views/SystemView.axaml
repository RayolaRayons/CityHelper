<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.SystemSection.ViewModels"
             x:Class="CityHelper.Tools.SystemSection.Views.SystemView"
             x:DataType="vm:SystemViewModel">

  <UserControl.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="220,Auto,*">

    <!-- The sections -->
    <TreeView Grid.Column="0" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" Margin="8">
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:SystemNode" ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Title}" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource ChBorder}" ResizeDirection="Columns" />

    <!-- One page: the chosen section -->
    <Grid Grid.Column="2" RowDefinitions="*,Auto" Margin="16,16,16,12">

      <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,16,0" DataContext="{Binding SelectedSection}" x:DataType="vm:SystemSectionItem">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
          <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="0,1,0,0" />
          <ContentControl Content="{Binding Content}" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Button Content="Save Options" Command="{Binding SaveCommand}" MinWidth="110" HorizontalContentAlignment="Center"
                ToolTip.Tip="Save all options (Ctrl+S)" />
        <Button Content="Revert" Command="{Binding RevertCommand}" MinWidth="90" HorizontalContentAlignment="Center"
                ToolTip.Tip="Drop unsaved changes and show the saved options again" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.8"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
