<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.LogManager.ViewModels"
             x:Class="CityHelper.Tools.LogManager.Views.LogManagerView"
             x:DataType="vm:LogManagerViewModel">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Select Daily Logs" Command="{Binding SelectDailyLogsCommand}" Padding="18,6"
                ToolTip.Tip="Checks every log that is not a merged log (weekly, monthly or merged). Logs open in the game can't be selected." />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <Button Content="Merge" Command="{Binding MergeCommand}" Padding="18,6"
                ToolTip.Tip="Combines the checked files into one file. Logs open in the game are skipped." />
        <Button Content="{Binding PeriodMergeText}" Command="{Binding MergePeriodCommand}" Padding="18,6" IsVisible="{Binding HasPeriodMerge}"
                ToolTip.Tip="Combines the checked logs (or all the daily logs if none are checked) into one file per week or month, as chosen under Options > Logs > Log Manager (Merge type). Logs open in the game are skipped." />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <Button Content="Insert Channels" Command="{Binding InsertChannelsCommand}" Padding="18,6"
                ToolTip.Tip="Adds [Combat], [System], [Reward] or [Auction] to the lines of the checked files that have no channel but are known messages. Emotes are left alone." />
        <Button Content="Fix System" Command="{Binding FixSystemCommand}" Padding="18,6"
                ToolTip.Tip="A channel that is a timestamp, e.g. [05:53], becomes [System] in the checked files." />
        <Button Content="Cleanup Logfile" Command="{Binding CleanupLogfileCommand}" Padding="18,6"
                ToolTip.Tip="Removes the channels that are not selected in Options > Log Manager from the checked files. A large removal asks first." />
      </StackPanel>
      <TextBlock Text="{Binding FolderText}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ChWarn}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="36,*,100,150" Margin="0,12,0,2">
      <TextBlock Grid.Column="1" Text="File" FontWeight="SemiBold" Opacity="0.8" />
      <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Opacity="0.8" HorizontalAlignment="Right" Margin="0,0,12,0" />
      <TextBlock Grid.Column="3" Text="Modified" FontWeight="SemiBold" Opacity="0.8" />
    </Grid>

    <ListBox ItemsSource="{Binding Files}" SelectionMode="Single">
      <!-- A log the game has open is greyed out and can't be selected or checked -->
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:LogFileViewModel">
          <Setter Property="IsEnabled" Value="{Binding !IsInUse}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LogFileViewModel">
          <Grid ColumnDefinitions="36,*,100,150">
            <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Margin="4,0,0,0" />
            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,12,0" Opacity="0.8" />
            <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" VerticalAlignment="Center" Opacity="0.8" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
