<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.LogManager.ViewModels"
             x:Class="CityHelper.Tools.LogManager.Views.LogManagerView"
             x:DataType="vm:LogManagerViewModel">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Merge" Command="{Binding MergeCommand}" Padding="18,6" />
        <ComboBox MinWidth="120" ItemsSource="{Binding MergeTypes}" SelectedItem="{Binding SelectedMergeType}"
                  ToolTip.Tip="Selected: all checked files into one. Weekly / Monthly: selects the daily logs and merges them into one file per week / month. Logs open in the game are skipped." />
        <Border Width="1" Background="#3F3F46" Margin="6,2" />
        <Button Content="Cleanup Logfile" Command="{Binding CleanupCommand}" Padding="18,6"
                ToolTip.Tip="Removes the channels that are not selected in Options from the checked files." />
      </StackPanel>
      <TextBlock Text="{Binding FolderText}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding StatusText}" Foreground="#E5C07B" TextWrapping="Wrap" />
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="36,*,100,150" Margin="0,12,0,2">
      <TextBlock Grid.Column="1" Text="File" FontWeight="SemiBold" Opacity="0.8" />
      <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Opacity="0.8" HorizontalAlignment="Right" Margin="0,0,12,0" />
      <TextBlock Grid.Column="3" Text="Modified" FontWeight="SemiBold" Opacity="0.8" />
    </Grid>

    <ListBox ItemsSource="{Binding Files}" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LogFileViewModel">
          <Grid ColumnDefinitions="36,*,100,150">
            <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Margin="4,0,0,0" />
            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,12,0" Opacity="0.8" />
            <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" VerticalAlignment="Center" Opacity="0.8" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
