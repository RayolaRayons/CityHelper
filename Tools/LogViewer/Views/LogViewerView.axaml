<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CityHelper.Tools.LogViewer.ViewModels"
             xmlns:v="using:CityHelper.Tools.LogViewer.Views"
             xmlns:m="using:CityHelper.Tools.LogViewer"
             x:Class="CityHelper.Tools.LogViewer.Views.LogViewerView"
             x:DataType="vm:LogViewerViewModel">

  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ChSelectedRow}" />
    </Style>
    <Style Selector="Button.mini">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="12">
    <!-- Log file + display toggles -->
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <TextBlock Text="Log file:" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                  PlaceholderText="No log files" />
      </Grid>
      <WrapPanel ItemSpacing="8" LineSpacing="6">
        <ToggleButton Content="Dates" IsChecked="{Binding ShowDates}" ToolTip.Tip="Show the date on each line" />
        <ToggleButton Content="Times" IsChecked="{Binding ShowTimes}" ToolTip.Tip="Show the time on each line" />
        <ToggleButton Content="Channels" IsChecked="{Binding ShowChannels}" ToolTip.Tip="Show the [channel] on each line" />
        <ToggleButton Content="Characters" IsChecked="{Binding ShowCharacters}" ToolTip.Tip="Show who said it" />
        <ToggleButton Content="Cleanup" IsChecked="{Binding ShowCleanup}"
                      ToolTip.Tip="Mark in red the lines Cleanup Logfile would remove (the channels unchecked in Options > Log Manager)" />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                ToolTip.Tip="Reload the log file from disk, keeping the channel and character filters, and run the current search again (F5)" />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <Button Content="Copy" Click="OnCopyClick"
                ToolTip.Tip="Copy the selected lines (Ctrl+C), as shown: hidden dates, times, channels and color codes are left out. Ctrl+A selects all." />
        <Border Width="1" Background="{DynamicResource ChBorder}" Margin="6,2" />
        <Button Content="Fix System" Command="{Binding FixSystemCommand}"
                ToolTip.Tip="Rewrite channels that are a timestamp, e.g. [05:53], as [System] in this log file (needs the option in Options > Log Manager)." />
        <Button Content="Insert Channels" Command="{Binding InsertChannelsCommand}"
                ToolTip.Tip="Add [Combat] or [System] to the lines of this log that have no channel but are known combat or system messages. Emotes are left alone." />
        <Button Content="Cleanup Logfile" Command="{Binding CleanupLogfileCommand}"
                ToolTip.Tip="Remove the channels that are not selected in Options > Log Manager from this log file." />
      </WrapPanel>

      <!-- Second row: highlight / search -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox Width="120" ItemsSource="{Binding FindModes}" SelectedItem="{Binding FindMode}"
                  ToolTip.Tip="Highlight marks the text in the lines. Search marks it too and lets you step through the lines that contain it." />
        <TextBox Text="{Binding HighlightText}" Width="260" PlaceholderText="word or phrase (separate several with commas)">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding NextResultCommand}" />
            <KeyBinding Gesture="Shift+Enter" Command="{Binding PreviousResultCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Content="◀" Command="{Binding PreviousResultCommand}" ToolTip.Tip="Previous result (Shift+Enter)" />
        <Button Content="▶" Command="{Binding NextResultCommand}" ToolTip.Tip="Next result (Enter)" />
      </StackPanel>
    </StackPanel>

    <!-- Channel and character filters -->
    <Grid DockPanel.Dock="Right" Width="250" Margin="12,10,0,0" RowDefinitions="*,*">
      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Top" Text="Channels" FontWeight="SemiBold" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,4">
          <Button Classes="mini" Content="All" Command="{Binding CheckAllChannelsCommand}" />
          <Button Classes="mini" Content="None" Command="{Binding UncheckAllChannelsCommand}" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="1">
          <ListBox ItemsSource="{Binding ChannelItems}" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterItemViewModel">
                <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" Margin="6,1" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <DockPanel Grid.Row="1">
        <TextBlock DockPanel.Dock="Top" Text="Characters" FontWeight="SemiBold" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,4">
          <Button Classes="mini" Content="All" Command="{Binding CheckAllCharactersCommand}" />
          <Button Classes="mini" Content="None" Command="{Binding UncheckAllCharactersCommand}" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource ChBorder}" BorderThickness="1">
          <ListBox ItemsSource="{Binding CharacterItems}" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FilterItemViewModel">
                <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}" Margin="6,1" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Grid>

    <!-- The log -->
    <Border Margin="0,10,0,0" BorderBrush="{DynamicResource ChBorder}" BorderThickness="1" Background="{DynamicResource ChLogBg}">
      <ListBox x:Name="LogList" ItemsSource="{Binding VisibleLines}" SelectionMode="Multiple" Background="Transparent"
               FontFamily="Cascadia Mono, Consolas, Courier New, monospace" FontSize="12.5"
               ScrollViewer.HorizontalScrollBarVisibility="{Binding HorizontalScroll}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="m:LogLine">
            <Grid ColumnDefinitions="60,*">
              <TextBlock Text="{Binding Number}" Foreground="{DynamicResource ChAccent}" HorizontalAlignment="Right" Margin="0,0,10,0" />
              <v:LogLineText Grid.Column="1" Line="{Binding}"
                             Options="{Binding $parent[ListBox].((vm:LogViewerViewModel)DataContext).Display}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</UserControl>
